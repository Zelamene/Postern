ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:8080
Authentication__SigningKey=replace-with-at-least-32-random-bytes-for-local-development
Authentication__Issuer=Postern
Authentication__Audience=Postern.Web
ConnectionStrings__Postgres=Host=db;Port=5432;Database=postern;Username=postern_app;Password=replace-with-local-runtime-password;Search Path=postern
Ingest__SharedSecret=replace-with-a-long-random-ingest-secret
Alias__Domain=postern.local
Alias__SuffixLength=4
